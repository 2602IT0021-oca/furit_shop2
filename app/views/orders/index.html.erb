
<h1>注文履歴一覧</h1>

<% if @orders.any? %>
  <% @orders.group_by { |order| order.created_at.strftime("%Y年%m月%d日") }.each do |ordered_at, grouped_orders| %>

    <h3><%= ordered_at %></h3>

    <% grouped_orders.each do |order| %>
      <h4>注文番号: <%= order.id %></h4>

      <table>
        <thead>
          <tr>
            <th>商品名</th>
            <th>数量</th>
            <th>単価</th>
            <th>小計</th>
          </tr>
        </thead>

        <tbody>
          <% order.order_details.each do |detail| %>
            <tr>
              <td><%= detail.product.name %></td>
              <td><%= detail.quantity %> 個</td>
              <td><%= number_to_currency(detail.price, unit: "¥", precision: 0) %></td>
              <td><%= number_to_currency(detail.price * detail.quantity, unit: "¥", precision: 0) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>

      <p>
        <strong>合計金額:</strong>
        <%= number_to_currency(order.total_price, unit: "¥", precision: 0) %>
      </p>

      <p>
        <strong>配送先:</strong>
        <%= order.address %>
      </p>

      <hr>
    <% end %>
  <% end %>
<% else %>
  <p>注文履歴はまだありません。</p>
<% end %>
