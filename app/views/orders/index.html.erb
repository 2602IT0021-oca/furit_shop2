<h1>注文履歴一覧</h1>

<% if @orders.any? %>
  <% @orders.each do |order| %>

    <p>
      <strong>
        注文日時：<%= order.created_at.strftime("%Y年%m月%d日 %H:%M") %>
      </strong>
    </p>

    <table>
      <thead>
        <tr>
          <th>商品名</th>
          <th>数量</th>
          <th>価格</th>
          <th>小計</th>
        </tr>
      </thead>

      <tbody>
        <% order.order_details.each do |detail| %>
          <tr>
            <td><%= detail.product.name %></td>
            <td><%= detail.quantity %></td>
            <td><%= "¥" + number_with_delimiter(detail.price) %></td>
            <td><%= "¥" + number_with_delimiter(detail.price * detail.quantity) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <p>
      <strong>
        合計金額：<%= "¥" + number_with_delimiter(order.total_price) %>
      </strong>
    </p>

    <p>
      配送先：<%= order.address %>
    </p>

    <hr>

  <% end %>
<% else %>
  <p>注文履歴はまだありません。</p>
<% end %>