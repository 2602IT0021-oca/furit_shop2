<h1>注文完了</h1>

<h3>ご注文が完了しました。</h3>

<h4>注文商品</h4>

<% @order.order_details.each do |detail| %>
  <div>
    <p>商品名: <%= detail.product.name %></p>
    <p>個数: <%= detail.quantity %> 個</p>
    <p>小計: <%= detail.product.price * detail.quantity %> 円</p>
  </div>
  <hr>
<% end %>

<h4>合計金額</h4>
<p><%= @order.total_price %> 円</p>

<%= link_to "商品一覧に戻る", products_path %>