
<h1>注文確認</h1>

<h3>注文商品一覧</h3>

<table>
  <thead>
    <tr>
      <th>商品名</th>
      <th>個数</th>
      <th>価格</th>
      <th>小計</th>
    </tr>
  </thead>
  <tbody>
    <% @order.order_details.each do |detail| %>
      <tr>
        <td><%= detail.product.name %></td>
        <td><%= detail.quantity %> 個</td>
        <td><%= number_to_currency(detail.price, unit: "¥", precision: 0) %></td>
        <td><%= number_to_currency(detail.price * detail.quantity, unit: "¥", precision: 0) %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<h4>合計金額</h4>
<p><%= number_to_currency(@order.total_price, unit: "¥", precision: 0) %></p>

<h4>送り先</h4>
<p><%= @order.address %></p>

<%= form_with model: @order, url: orders_path, local: true, data: { turbo: false } do |form| %>
  <%= form.hidden_field :address %>
  <%= form.submit "注文確定" %>
<% end %>

<%= link_to "注文画面に戻る", new_order_path %>
