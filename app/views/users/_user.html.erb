<div id="<%= dom_id user %>">
   <div id="<%= dom_id user %>">
    <p>
      <strong>Name:</strong>
      <%= user.name %>
    </p>

   <p>
     <strong>Photo:</strong>
     <% if user.photo.attached? %>
       <%= image_tag user.photo %>
     <% end %>
   </p>
  </div>

  <div>
    <strong>Age:</strong>
    <%= user.age %>
  </div>

  <div>
    <strong>Password:</strong>
    <%= user.password %>
  </div>

  <div>
    <strong>Email:</strong>
    <%= user.email %>
  </div>

</div>
